// Benign hard negatives: everyday admin / developer use of the same binaries the malicious seeds abuse
// (curl, wget, ssh, sudo, chmod, crontab, python -c ...), so the model learns context, not binary names.
// Boros et al. 2022 §3: ambiguous commands are kept out of the malicious set; they belong here.
{"chain": ["systemd", "systemd", "kitty", "bash", "curl"], "cmdline": "curl -fsSL https://api.github.com/repos/rust-lang/rust/releases/latest"}
{"chain": ["systemd", "systemd", "kitty", "bash", "curl"], "cmdline": "curl -LO https://github.com/neovim/neovim/releases/download/v0.11.0/nvim-linux-x86_64.tar.gz"}
{"chain": ["systemd", "systemd", "kitty", "bash", "wget"], "cmdline": "wget https://download.pytorch.org/whl/cpu/torch-2.8.0-cp312-linux_x86_64.whl"}
{"chain": ["systemd", "systemd", "kitty", "bash", "tar"], "cmdline": "tar xzf nvim-linux-x86_64.tar.gz -C /home/user/.local"}
{"chain": ["systemd", "systemd", "kitty", "bash", "chmod"], "cmdline": "chmod +x scripts/install.sh"}
{"chain": ["systemd", "systemd", "kitty", "bash", "chmod"], "cmdline": "chmod 600 /home/user/.ssh/id_ed25519"}
{"chain": ["systemd", "systemd", "kitty", "bash", "ssh"], "cmdline": "ssh -i /home/user/.ssh/id_ed25519 user@192.168.1.20"}
